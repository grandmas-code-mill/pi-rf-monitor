# settings for rfmon-capture.service. edit, then: sudo systemctl start rfmon-capture

# center frequency in hz (pick a strong local fm station)
RFMON_FREQ=101.1e6

# seconds to record (5 s at 2.048 ms/s is about 20 mb)
RFMON_SECONDS=5

# anything else for rfmon capture, e.g. "-g 20.7" for a fixed gain
RFMON_EXTRA_ARGS=